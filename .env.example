# Токен бота от @BotFather (команда /newbot)
BOT_TOKEN=

# Ключ Gemini API из Google AI Studio — https://aistudio.google.com/apikey
# Новые ключи начинаются с "AQ." (старый формат "AIza" выводится из употребления).
# Копировать целиком, вместе с точками.
GEMINI_API_KEY=

# Модели Gemini через запятую, порядок = приоритет: если первая упёрлась в дневной
# лимит (429) или пропала (404) — бот переходит к следующей, и так до конца списка.
# ЛУЧШЕ НЕ ЗАДАВАТЬ — в коде уже есть список из 7 моделей (lite для скорости и
# квоты + full flash про запас). Задавай только чтобы поменять порядок,
# например для демо поставить полную модель первой:
# GEMINI_MODEL=gemini-3.6-flash, gemini-3.5-flash-lite

# Необязательно: Telegram user ID через запятую — кто может пользоваться ботом.
# Пусто — бот отвечает всем. Свой ID покажет @userinfobot.
ALLOWED_USER_IDS=
